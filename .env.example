# Copy this file to backend/.env and fill in your values

# Application
DEBUG=false

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://aicost:changeme@localhost:5432/aicost_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM Backend: mock | ollama | lmstudio | openai_compat
LLM_BACKEND=mock
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

# Data refresh schedule: daily | weekly | manual
REFRESH_INTERVAL=daily

# Batch analysis threshold in seconds
BATCH_THRESHOLD_SECONDS=120

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
